{
  "name": "czahner-com",
  "private": true,
  "version": "2.0.0",
  "description": "Personal site and maintenance-planning tools for Chad Zahner — React + TypeScript, built with Vite and deployed to GitHub Pages.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && tsx scripts/prerender.tsx",
    "preview": "vite preview",
    "ci": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "docx": "8.5.0",
    "papaparse": "5.7.0",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
